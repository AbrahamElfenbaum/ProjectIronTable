        <mxCell id="s3" parent="1" style="text;html=1;fontStyle=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;" value="PANEL LAYOUT SAVE (runtime)" vertex="1">
          <mxGeometry height="30" width="260" x="500" y="530" as="geometry" />
