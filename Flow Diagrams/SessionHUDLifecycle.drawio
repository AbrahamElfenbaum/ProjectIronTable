<mxfile host="app.diagrams.net">
  <diagram name="Session HUD Lifecycle" id="hud-lifecycle">
    <mxGraphModel dx="943" dy="518" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s1" parent="1" style="text;html=1;fontStyle=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;" value="STARTUP (BeginPlay — local clients only)" vertex="1">
          <mxGeometry height="30" width="340" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="10" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="ASessionController::BeginPlay()&#xa;→ UIComponent-&gt;Init()&#xa;→ ChatComponent-&gt;Init()" vertex="1">
          <mxGeometry height="60" width="220" x="100" y="70" as="geometry" />
        </mxCell>
        <mxCell id="11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="USessionUIComponent::Init()&#xa;Guard: not local controller → return&#xa;Cast owner → ASessionController&#xa;Cache PlayerControllerRef" vertex="1">
          <mxGeometry height="70" width="260" x="80" y="150" as="geometry" />
        </mxCell>
        <mxCell id="12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="CreateWidget(SessionScreenClass)&#xa;AddToViewport()&#xa;Cache SessionScreenRef" vertex="1">
          <mxGeometry height="70" width="260" x="80" y="240" as="geometry" />
        </mxCell>
        <mxCell id="13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="GetWidgetFromName() for each:&#xa;• DiceTray&#xa;• ChatBox&#xa;• PlayerList&#xa;• Taskbar" vertex="1">
          <mxGeometry height="90" width="260" x="80" y="330" as="geometry" />
        </mxCell>
        <mxCell id="13b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Chat Log Restore (ChatBox found):&#xa;&#xa;Load USessionSave from slot &quot;Session_{SessionID}&quot;&#xa;For each ChatLog entry:&#xa;  Split key on | → participant list&#xa;  ChatBox::FindOrCreateChannel()&#xa;  Channel::RestoreMessage() per record&#xa;  (bypasses routing, notification, channel switch)" vertex="1">
          <mxGeometry height="120" width="300" x="60" y="440" as="geometry" />
        </mxCell>
        <mxCell id="a13b" edge="1" parent="1" source="13" style="edgeStyle=orthogonalEdgeStyle;" target="13b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13c" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Notes Restore (SessionNotesPanel found):&#xa;&#xa;LoadSessionNotesSave(WorldContext) → USessionNotesSave*&#xa;No save? → SessionNotesPanel::CreateChannel (default private tab)&#xa;Save found? → SessionNotesPanel::RestoreChannels(save)&#xa;  For each FNoteRecord: CreateChannel, SetDocument(Content)" vertex="1">
          <mxGeometry height="160" width="300" x="60" y="590" as="geometry" />
        </mxCell>
        <mxCell id="a13c" edge="1" parent="1" source="13b" style="edgeStyle=orthogonalEdgeStyle;" target="13c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="FindAndRegisterPanel() for each:&#xa;• DicePanel → &quot;Dice&quot;&#xa;• ChatPanel → &quot;Chat&quot;&#xa;• PlayersPanel → &quot;Players&quot;&#xa;• SessionNotesPanelDraggable → &quot;Notes&quot;&#xa;&#xa;Finds UDraggablePanel by name&#xa;Registers with Taskbar (toggle button)&#xa;Binds OnDragged/OnResized/OnToggled → SavePanelLayout" vertex="1">
          <mxGeometry height="150" width="300" x="60" y="780" as="geometry" />
        </mxCell>
        <mxCell id="15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="LoadPanelLayout()&#xa;&#xa;Load UPanelLayoutSave from slot &quot;PanelLayout&quot;&#xa;Apply saved Position/Size/Visibility&#xa;to each registered UDraggablePanel" vertex="1">
          <mxGeometry height="90" width="260" x="80" y="960" as="geometry" />
        </mxCell>
        <mxCell id="16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Bind delegates:&#xa;• DiceTray.OnAllDiceRolled → AddRollResultToChat&#xa;• DiceTray.OnDiceFailsafeDestroyed → OnDiceFailsafeHandler&#xa;• DiceTray.OnRollInitiated → OnRollInitiated&#xa;• PlayerList.OnPlayerAddressClicked → OnPlayerAddressClicked" vertex="1">
          <mxGeometry height="100" width="320" x="50" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="ADiceSpawnVolume found via GetActorOfClass&#xa;Assigned to DiceTray.SpawnVolume&#xa;&#xa;USessionChatComponent::Init()&#xa;Get ChatBoxRef from UIComponent-&gt;GetChatBox()&#xa;ChatBoxRef-&gt;SetChatComponent(this)" vertex="1">
          <mxGeometry height="100" width="280" x="70" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="text;html=1;fontStyle=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;" value="CHAT RPC FLOW (runtime)" vertex="1">
          <mxGeometry height="30" width="260" x="500" y="20" as="geometry" />
        </mxCell>
        <mxCell id="20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="ChatBox calls&#xa;ChatComponent::SendChatMessageOnServer()&#xa;[Server RPC]" vertex="1">
          <mxGeometry height="70" width="240" x="510" y="70" as="geometry" />
        </mxCell>
        <mxCell id="21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Server validates message&#xa;Recipients empty? → broadcast to ALL&#xa;Recipients set? → send to sender + recipients only&#xa;&#xa;After routing:&#xa;Persist to USessionSave ChatLog&#xa;(sorted pipe-joined participant key)" vertex="1">
          <mxGeometry height="110" width="260" x="500" y="180" as="geometry" />
        </mxCell>
        <mxCell id="22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="AddChatMessageOnOwningClient()&#xa;[Client RPC]&#xa;bIsSender = (this client == sender)" vertex="1">
          <mxGeometry height="70" width="240" x="510" y="300" as="geometry" />
        </mxCell>
        <mxCell id="23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="ChatBoxRef::AddChatMessage()&#xa;Routes to correct channel" vertex="1">
          <mxGeometry height="60" width="220" x="520" y="410" as="geometry" />
